<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pfad · Spieler</title><link rel="stylesheet" href="style.css"></head><body><div class="wrap"><h1>☾ Pfad der Potenzen</h1><div id="join" class="card"><h2>Beitreten</h2><input id="room" placeholder="Raumcode" maxlength="6"><input id="name" placeholder="Spitzname" maxlength="20"><h3>Farbe</h3><div id="colors" class="row"></div><h3>Figur</h3><div id="avatars" class="row"></div><h3>Teamwunsch</h3><select id="teamChoice"><option value="auto">Automatisch</option><option value="blue">🔵 Blau</option><option value="red">🔴 Rot</option></select><button id="joinBtn" class="primary">BEITRETEN</button><p id="joinError"></p></div><div id="play" class="hidden"><div class="card"><div class="row"><b id="me" class="grow"></b><span id="identity" class="pill"></span><span id="stats" class="pill"></span></div><div class="row items"><button data-item="torch">🔥 <span id="torch"></span></button><button data-item="shield">🛡 <span id="shield"></span></button><button data-item="potion">🧪 <span id="potion"></span></button><button data-item="book">📖 <span id="book"></span></button></div></div><div class="card"><div class="row"><h2 class="grow">Laden</h2><button id="shopToggle">ÖFFNEN</button></div><div id="shop" class="hidden shopGrid"></div></div><div class="card"><div class="row"><div id="pstatus" class="muted grow">Warte …</div><b id="pTimer" class="pill">--</b></div><h2 id="pquestion">…</h2><div id="answers" class="answers"></div><p id="hint"></p></div></div></div><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script src="config.js?v=9"></script><script src="common.js?v=9"></script><script src="player.js?v=9"></script></body></html>
